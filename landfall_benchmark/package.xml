<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>landfall_benchmark</name>
  <version>0.0.0</version>
  <description>
    Evaluation against simulator ground truth, and (from M7) the kidnap benchmark runner and
    scenarios for Landfall.
  </description>
  <maintainer email="a.pahlevani1998@gmail.com">Ali Pahlevani</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/ali-pahlevani/Landfall</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>landfall_core</depend>
  <depend>landfall_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
