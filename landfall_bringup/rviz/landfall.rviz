# RViz view of Landfall with AMCL and Nav2: the map, the scan, AMCL's particles and pose, the
# robot, and the relocalizer's markers (hypotheses, the matched keyframes) and debug image.
#   ros2 run rviz2 rviz2 -d $(ros2 pkg prefix landfall_bringup)/share/landfall_bringup/rviz/landfall.rviz
# Tools: 2D Pose Estimate (/initialpose) and Nav2's goal tool.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Size (m): 0.05
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 64; 64
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL particles
      Enabled: true
      Color: 0; 180; 0
      Shape: Arrow (Flat)
      Topic:
        Value: /particle_cloud
        Depth: 5
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose
      Enabled: true
      Topic:
        Value: /amcl_pose
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Landfall markers
      Enabled: true
      Topic:
        Value: /landfall_relocalizer/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Landfall debug image
      Enabled: true
      Normalize Range: true
      Topic:
        Value: /landfall_relocalizer/debug_image
        Depth: 1
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.068539
      Topic:
        Value: /initialpose
        Depth: 5
        Reliability Policy: Reliable
    - Class: nav2_rviz_plugins/GoalTool
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 40
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
