<!--
  Landfall: Nav2's navigate_to_pose_w_replanning_and_recovery.xml for Lyrical (nav2_bt_navigator
  1.5, Apache-2.0, Open Navigation LLC and contributors) with relocalization; see
  docs/nav2_integration.md.
  - Before navigating: if the localization isn't certain (IsLocalized on amcl_pose), ask the
    relocalizer for a pose (ReLocalize), looking around: after a failed attempt the robot turns
    by 45 degrees (Spin) and asks again, from up to eight headings, since the map may hold views
    of the place in some directions only. Nav2 refuses a goal while the robot has no pose at all, so
    a robot that starts unlocalized needs the relocalizer's startup trigger.
  - Relocalizing, looking around the same way, is the first recovery action: a robot whose
    localization has gone wrong (moved while switched off, kidnapped) gets a pose from vision before
    Nav2's other recoveries run. As in Nav2's tree, recoveries run for the controller and planner
    errors they can help with.
  After a relocalization, the tree waits a second for AMCL's map -> odom to follow the new pose,
  then clears both costmaps (while the pose was wrong, scans marked obstacles in the wrong places)
  and, in the recovery, plans the path again from the new pose before navigation resumes. Each ReLocalize lets the relocalizer take 2.5 s (timeout) and waits
  12.5 s for its answer (server_timeout, default: timeout + 10 s). The tree ID differs from Nav2's own, which the
  navigator loads from its bt_search_directories too.
-->
<root BTCPP_format="4" main_tree_to_execute="NavigateToPoseWithRelocalization">
  <BehaviorTree ID="NavigateToPoseWithRelocalization">
    <Sequence name="RelocalizeThenNavigate">
      <Fallback name="EnsureLocalized">
        <IsLocalized pose_topic="amcl_pose" max_std_xy="0.5" max_std_yaw_deg="15"/>
        <Sequence name="RelocalizeBeforeNavigating">
          <Fallback name="ReLocalizeBeforeNavigatingLookingAround">
            <ReLocalize name="ReLocalizeBeforeNavigating" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
            <Sequence>
              <Spin spin_dist="0.785"/>
              <ReLocalize name="ReLocalizeBeforeNavigating45" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
            </Sequence>
            <Sequence>
              <Spin spin_dist="0.785"/>
              <ReLocalize name="ReLocalizeBeforeNavigating90" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
            </Sequence>
            <Sequence>
              <Spin spin_dist="0.785"/>
              <ReLocalize name="ReLocalizeBeforeNavigating135" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
            </Sequence>
            <Sequence>
              <Spin spin_dist="0.785"/>
              <ReLocalize name="ReLocalizeBeforeNavigating180" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
            </Sequence>
            <Sequence>
              <Spin spin_dist="0.785"/>
              <ReLocalize name="ReLocalizeBeforeNavigating225" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
            </Sequence>
            <Sequence>
              <Spin spin_dist="0.785"/>
              <ReLocalize name="ReLocalizeBeforeNavigating270" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
            </Sequence>
            <Sequence>
              <Spin spin_dist="0.785"/>
              <ReLocalize name="ReLocalizeBeforeNavigating315" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
            </Sequence>
          </Fallback>
          <Wait name="WaitForLocalization-BeforeNavigating" wait_duration="1.0"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Relocalized" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Relocalized" service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </Fallback>
      <RecoveryNode number_of_retries="6" name="NavigateRecovery">
        <PipelineSequence name="NavigateWithReplanning">
          <ProgressCheckerSelector selected_progress_checker="{selected_progress_checker}" default_progress_checker="progress_checker" topic_name="progress_checker_selector"/>
          <GoalCheckerSelector selected_goal_checker="{selected_goal_checker}" default_goal_checker="general_goal_checker" topic_name="goal_checker_selector"/>
          <PathHandlerSelector selected_path_handler="{selected_path_handler}" default_path_handler="PathHandler" topic_name="path_handler_selector"/>
          <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
          <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
          <RateController hz="1.0">
            <RecoveryNode number_of_retries="1" name="ComputePathToPose">
              <Fallback name="FallbackComputePathToPose">
                <ReactiveSequence name="CheckIfNewPathNeeded">
                  <Inverter>
                    <GlobalUpdatedGoal/>
                  </Inverter>
                  <IsGoalNearby path="{path}" proximity_threshold="4.0" max_robot_pose_search_dist="1.5"/>
                  <TruncatePathLocal input_path="{path}" output_path="{remaining_path}" distance_forward="-1" distance_backward="0.0" />
                  <ValidatePath path="{remaining_path}"/>
                </ReactiveSequence>
                <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
              </Fallback>
              <Sequence>
                <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              </Sequence>
            </RecoveryNode>
          </RateController>
          <RecoveryNode number_of_retries="1" name="FollowPath">
            <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}" error_msg="{follow_path_error_msg}" tracking_feedback="{tracking_feedback}"/>
            <Sequence>
              <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
              <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            </Sequence>
          </RecoveryNode>
        </PipelineSequence>
        <Sequence>
          <Fallback>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
          </Fallback>
          <ReactiveFallback name="RecoveryFallback">
            <GoalUpdated/>
            <RoundRobin name="RecoveryActions">
              <Sequence name="RelocalizeAndReplan">
                <Fallback name="ReLocalizeRecoveryLookingAround">
                  <ReLocalize name="ReLocalizeRecovery" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
                  <Sequence>
                    <Spin spin_dist="0.785"/>
                    <ReLocalize name="ReLocalizeRecovery45" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
                  </Sequence>
                  <Sequence>
                    <Spin spin_dist="0.785"/>
                    <ReLocalize name="ReLocalizeRecovery90" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
                  </Sequence>
                  <Sequence>
                    <Spin spin_dist="0.785"/>
                    <ReLocalize name="ReLocalizeRecovery135" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
                  </Sequence>
                  <Sequence>
                    <Spin spin_dist="0.785"/>
                    <ReLocalize name="ReLocalizeRecovery180" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
                  </Sequence>
                  <Sequence>
                    <Spin spin_dist="0.785"/>
                    <ReLocalize name="ReLocalizeRecovery225" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
                  </Sequence>
                  <Sequence>
                    <Spin spin_dist="0.785"/>
                    <ReLocalize name="ReLocalizeRecovery270" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
                  </Sequence>
                  <Sequence>
                    <Spin spin_dist="0.785"/>
                    <ReLocalize name="ReLocalizeRecovery315" service_name="landfall_relocalizer/relocalize" timeout="2.5"/>
                  </Sequence>
                </Fallback>
                <Wait name="WaitForLocalization-Recovery" wait_duration="1.0"/>
                <ClearEntireCostmap name="ClearLocalCostmap-Relocalized" service_name="local_costmap/clear_entirely_local_costmap"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-Relocalized" service_name="global_costmap/clear_entirely_global_costmap"/>
                <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
              </Sequence>
              <Sequence name="ClearingActions">
                <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
              </Sequence>
              <Spin spin_dist="1.57" error_code_id="{spin_error_code}" error_msg="{spin_error_msg}"/>
              <Wait wait_duration="5.0" error_code_id="{wait_error_code}" error_msg="{wait_error_msg}"/>
              <BackUp backup_dist="0.30" backup_speed="0.15" error_code_id="{backup_error_code}" error_msg="{backup_error_msg}"/>
            </RoundRobin>
          </ReactiveFallback>
        </Sequence>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
